---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section class="card" id={id}>
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .card {
    background: var(--white);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius);
    padding: 28px 24px;
    margin-top: 20px;
  }
</style>
